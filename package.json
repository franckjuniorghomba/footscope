{
  "name": "footscope",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
